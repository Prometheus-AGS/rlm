# RLM Server Configuration

# Server settings
RLM_SERVER_HOST=0.0.0.0
RLM_SERVER_PORT=5269

# LLM provider settings
RLM_LLM_PROVIDER=openai
RLM_LLM_MODEL=gpt-5.2
RLM_LLM_API_KEY=your_api_key_here
RLM_API_BASE_URL=https://api.openai.com/v1

# Context settings
RLM_MAX_CONTEXT_SIZE=128000
RLM_MAX_ITERATIONS=10

# Logging settings
RLM_LOG_LEVEL=info
RLM_LOG_FORMAT=json

